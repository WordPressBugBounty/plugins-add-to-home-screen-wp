msgstr ""
"Choisissez où afficher l'infobulle flottante dans l'interface publique."

#: add-to-home-screen-wp.php:352 add-to-home-screen-wp.php:604
msgid "Show to Returning Visitors Only"
msgstr "Afficher uniquement aux visiteurs récurrents"

